# ==============================================
# PRODUCTION ENVIRONMENT
# ==============================================

# Backend API Configuration (HTTPS - Production)
VITE_API_BASE_URL=https://pms.upda.co.in:5001
VITE_API_URL=https://pms.upda.co.in/api-v1
# VITE_API_BASE_URL=http://localhost:5000
# VITE_API_URL=http://localhost:5000
# Application Configuration
VITE_APP_NAME=PMS
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Property Management System - Production
VITE_NODE_ENV=production
VITE_DEBUG_MODE=false
VITE_SHOW_DEV_TOOLS=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_HOT_RELOAD=false
VITE_MOCK_API=false
VITE_API_TIMEOUT=30000
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/octet-stream
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100
VITE_SESSION_TIMEOUT=3600000
VITE_LOG_LEVEL=error
VITE_CONSOLE_LOGS=false
VITE_ENABLE_CORS=true
VITE_ENABLE_CSRF_PROTECTION=true