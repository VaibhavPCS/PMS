# ==============================================
# PRODUCTION ENVIRONMENT
# ==============================================

# Backend API Configuration (HTTPS - Production)
# VITE_API_BASE_URL=https://pms.upda.co.in:5001
# VITE_API_URL=https://pms.upda.co.in/api-v1
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
# Application Configuration
VITE_APP_NAME=PMS
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Property Management System - Production

# Environment
VITE_NODE_ENV=production

# Debug Mode (Disabled in Production)
VITE_DEBUG_MODE=false
VITE_SHOW_DEV_TOOLS=false

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_HOT_RELOAD=false

# Production Settings
VITE_MOCK_API=false
VITE_API_TIMEOUT=30000

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# Session Configuration
VITE_SESSION_TIMEOUT=3600000

# Logging (Minimal in Production)
VITE_LOG_LEVEL=error
VITE_CONSOLE_LOGS=false

# Security Headers
VITE_ENABLE_CORS=true
VITE_ENABLE_CSRF_PROTECTION=true

# Optional: Analytics & Monitoring (Enable with your credentials)
# VITE_SENTRY_DSN=your-production-sentry-dsn
# VITE_GA_TRACKING_ID=your-google-analytics-id
# VITE_HOTJAR_ID=your-hotjar-id
