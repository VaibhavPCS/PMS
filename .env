# ==============================================
# LOCAL DEVELOPMENT ENVIRONMENT
# ==============================================

# Backend API Configuration (HTTP - Local)
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api-v1

# Application Configuration
VITE_APP_NAME=PMS
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Property Management System

# Environment
VITE_NODE_ENV=development

# Debug Mode
VITE_DEBUG_MODE=true
VITE_SHOW_DEV_TOOLS=true

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_HOT_RELOAD=true

# Local Development Settings
VITE_MOCK_API=false
VITE_API_TIMEOUT=30000

# File Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# Session Configuration
VITE_SESSION_TIMEOUT=3600000

# Logging
VITE_LOG_LEVEL=debug
VITE_CONSOLE_LOGS=true

# Optional: Analytics & Monitoring (Disabled in Dev)
# VITE_SENTRY_DSN=
# VITE_GA_TRACKING_ID=
